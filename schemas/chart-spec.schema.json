{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tochnyi.local/schemas/chart-spec.schema.json",
  "title": "Tochnyi ChartSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["recipe", "title", "subtitle", "date", "source", "data"],
  "properties": {
    "version": { "type": "string", "const": "2.0" },
    "recipe": {
      "type": "string",
      "enum": [
        "comparison.change",
        "comparison.scenarios",
        "comparison.diverging",
        "comparison.range",
        "trend.line",
        "composition.donut",
        "composition.stacked",
        "flow.waterfall",
        "ranking.horizontal",
        "status.grid",
        "story.sequence",
        "headline.metric"
      ]
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 100 },
    "subtitle": { "type": "string", "minLength": 1, "maxLength": 240 },
    "date": { "type": "string", "format": "date" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 180 },
        "period": { "type": "string", "maxLength": 80 },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "data": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 80 },
          "value": { "type": "number" },
          "low": { "type": "number" },
          "high": { "type": "number" },
          "benchmark": { "type": "number" },
          "displayValue": { "type": "string", "maxLength": 50 },
          "detail": { "type": "string", "maxLength": 180 },
          "annotation": { "type": "string", "maxLength": 120 },
          "tone": {
            "type": "string",
            "enum": ["primary", "secondary", "warning", "critical", "neutral", "positive"]
          },
          "status": {
            "type": "string",
            "enum": ["stable", "improving", "strained", "critical", "blocked", "unknown"]
          },
          "role": {
            "type": "string",
            "enum": ["start", "change", "subtotal", "end"]
          }
        }
      }
    },
    "references": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "label"],
        "properties": {
          "value": { "type": "number" },
          "label": { "type": "string", "minLength": 1, "maxLength": 80 },
          "tone": {
            "type": "string",
            "enum": ["primary", "secondary", "warning", "critical", "neutral", "positive"]
          },
          "lineStyle": { "type": "string", "enum": ["line", "dashed"] }
        }
      }
    },
    "measure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unit": { "type": "string", "maxLength": 40 },
        "axisTitle": { "type": "string", "maxLength": 80 },
        "prefix": { "type": "string", "maxLength": 12 },
        "suffix": { "type": "string", "maxLength": 20 },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 4 },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "baseline": { "type": "string", "enum": ["zero", "auto", "explicit"] },
        "scale": { "type": "string", "enum": ["linear", "logarithmic"] }
      }
    },
    "emphasis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "label"],
      "properties": {
        "direction": { "type": "string", "enum": ["up", "down", "neutral"] },
        "value": { "type": "number" },
        "displayValue": { "type": "string", "maxLength": 40 },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "position": { "type": "string", "enum": ["between", "corner", "left"] }
      }
    },
    "primaryMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": { "type": "string", "minLength": 1, "maxLength": 40 },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "supportingFacts": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "label"],
        "properties": {
          "value": { "type": "string", "minLength": 1, "maxLength": 60 },
          "label": { "type": "string", "minLength": 1, "maxLength": 180 },
          "tone": {
            "type": "string",
            "enum": ["primary", "secondary", "warning", "critical", "neutral", "positive"]
          }
        }
      }
    },
    "note": { "type": "string", "maxLength": 240 },
    "narrative": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frame": {
          "type": "string",
          "enum": ["neutral", "warning", "surprise", "collapse", "recovery", "divergence", "comparison"]
        },
        "density": { "type": "string", "enum": ["minimal", "editorial", "detailed"] },
        "emphasis": {
          "type": "string",
          "enum": ["magnitude", "direction", "gap", "composition", "ranking", "range", "flow", "status"]
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "height": { "type": "string", "enum": ["short", "standard", "tall"] },
        "sort": { "type": "string", "enum": ["none", "ascending", "descending"] },
        "showLegend": { "type": "boolean" },
        "showLabels": { "type": "boolean" },
        "animate": { "type": "boolean" },
        "labelMode": { "type": "string", "enum": ["auto", "inside", "outside"] }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "topic": { "type": "string", "maxLength": 100 },
        "country": { "type": "string", "maxLength": 80 },
        "dataPeriod": { "type": "string", "maxLength": 80 },
        "keyFinding": { "type": "string", "maxLength": 240 }
      }
    }
  }
}
