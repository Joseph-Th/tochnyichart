{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tochnyi.local/schemas/chart-spec.schema.json",
  "title": "Tochnyi ChartSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["recipe", "title", "date", "data"],
  "properties": {
    "version": { "type": "string", "const": "2.0" },
    "recipe": {
      "type": "string",
      "enum": [
        "comparison.change",
        "comparison.scenarios",
        "comparison.diverging",
        "comparison.range",
        "comparison.benchmark-gap",
        "comparison.dumbbell",
        "relationship.converging-signals",
        "trend.line",
        "trend.stacked",
        "timeline.duration",
        "composition.donut",
        "composition.stacked",
        "composition.components",
        "flow.waterfall",
        "ranking.horizontal",
        "map.regional"
      ]
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 100 },
    "subtitle": { "type": "string", "minLength": 1, "maxLength": 240 },
    "date": { "type": "string", "format": "date" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 180 },
        "period": { "type": "string", "maxLength": 80 },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "data": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "regionId": { "type": "string", "pattern": "^[A-Z]{2}-[A-Z0-9]{2,3}$" },
          "regionIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Z]{2}-[A-Z0-9]{2,3}$" }
          },
          "callout": { "type": "string", "enum": ["auto", "none"] },
          "calloutSide": { "type": "string", "enum": ["auto", "left", "right"] },
          "calloutOrder": { "type": "integer", "minimum": 0, "maximum": 99 },
          "label": { "type": "string", "minLength": 1, "maxLength": 80 },
          "quantity": { "type": "string", "minLength": 3, "maxLength": 80 },
          "group": { "type": "string", "minLength": 1, "maxLength": 60 },
          "icon": {
            "type": "string",
            "enum": ["dot", "person", "shield", "warehouse", "pause", "exit", "money", "ship", "fuel", "factory", "warning", "trend", "document"]
          },
          "direction": { "type": "string", "enum": ["up", "down", "neutral"] },
          "value": { "type": "number" },
          "valueStatus": { "type": "string", "enum": ["reported", "derived", "bound", "approximate"] },
          "period": { "type": "string", "minLength": 1, "maxLength": 80 },
          "scope": { "type": "string", "minLength": 1, "maxLength": 80 },
          "low": { "type": "number" },
          "high": { "type": "number" },
          "benchmark": { "type": "number" },
          "benchmarkDisplayValue": { "type": "string", "maxLength": 50 },
          "gapDisplayValue": { "type": "string", "maxLength": 50 },
          "start": { "type": "string", "format": "date" },
          "end": { "type": "string", "format": "date" },
          "duration": { "type": "integer", "minimum": 1 },
          "durationUnit": { "type": "string", "enum": ["days", "weeks", "months"] },
          "displayValue": { "type": "string", "maxLength": 50 },
          "detail": { "type": "string", "maxLength": 180 },
          "annotation": { "type": "string", "maxLength": 120 },
          "tone": {
            "type": "string",
            "enum": ["primary", "secondary", "warning", "critical", "neutral", "positive"]
          },
          "status": {
            "type": "string",
            "enum": ["stable", "improving", "strained", "critical", "blocked", "unknown"]
          },
          "role": {
            "type": "string",
            "enum": ["start", "change", "subtotal", "end"]
          },
          "relationshipRole": {
            "type": "string",
            "enum": ["driver", "outcome"]
          },
          "segments": {
            "type": "array",
            "minItems": 2,
            "maxItems": 15,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "value"],
              "properties": {
                "label": { "type": "string", "minLength": 1, "maxLength": 60 },
                "value": { "type": "number", "minimum": 0 },
                "displayValue": { "type": "string", "maxLength": 50 }
              }
            }
          }
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "operator", "formula"],
      "properties": {
        "mode": { "type": "string", "enum": ["identity", "directional"] },
        "operator": { "type": "string", "enum": ["multiply", "combine"] },
        "formula": { "type": "string", "minLength": 1, "maxLength": 140 }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "anchorDate": { "type": "string", "format": "date" }
      }
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regionSet"],
      "properties": {
        "regionSet": { "type": "string", "enum": ["russia"] },
        "callouts": { "type": "string", "enum": ["auto", "cards", "none"] },
        "calloutDistribution": { "type": "string", "enum": ["auto", "geographic", "balanced"] },
        "summaryPosition": { "type": "string", "const": "none" },
        "summaryDisplay": { "type": "string", "const": "hide" },
        "viewport": { "type": "string", "const": "all" },
        "viewportAlignment": { "type": "string", "const": "context" },
        "contextFit": { "type": "string", "const": "all" },
        "landmass": { "type": "string", "const": "continental" },
        "anchorStyle": { "type": "string", "enum": ["auto", "none"] },
        "leaderRouting": { "type": "string", "enum": ["auto", "direct", "ports", "indexed"] },
        "excludeRegions": {
          "type": "array",
          "maxItems": 0,
          "items": { "type": "string" }
        }
      }
    },
    "references": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "label"],
        "properties": {
          "value": { "type": "number" },
          "label": { "type": "string", "minLength": 1, "maxLength": 80 },
          "tone": {
            "type": "string",
            "enum": ["primary", "secondary", "warning", "critical", "neutral", "positive"]
          },
          "lineStyle": { "type": "string", "enum": ["line", "dashed"] }
        }
      }
    },
    "measure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "quantity": { "type": "string", "minLength": 3, "maxLength": 80 },
        "unit": { "type": "string", "maxLength": 40 },
        "axisTitle": { "type": "string", "maxLength": 80 },
        "valueMode": {
          "type": "string",
          "enum": ["level", "absolute-change", "relative-change", "rate", "share", "index"]
        },
        "levelAvailability": {
          "type": "string",
          "enum": ["reported", "retrievable", "unavailable", "incomparable", "not-applicable"]
        },
        "basisAvailability": {
          "type": "string",
          "enum": ["reported", "retrievable", "unavailable", "incomparable", "not-applicable"]
        },
        "basisNote": { "type": "string", "minLength": 1, "maxLength": 180 },
        "normalizationNote": { "type": "string", "minLength": 1, "maxLength": 180 },
        "prefix": { "type": "string", "maxLength": 12 },
        "suffix": { "type": "string", "maxLength": 20 },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 4 },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "baseline": { "type": "string", "enum": ["zero", "auto", "explicit"] },
        "scale": {
          "type": "string",
          "enum": ["linear", "logarithmic"],
          "description": "Use logarithmic only for genuinely multiplicative comparisons. Do not use logarithmic scale when the story is about an amount as a fraction of a benchmark or denominator; those comparisons must preserve proportional magnitude on a linear axis."
        }
      }
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": { "type": "string", "enum": ["ratio", "population"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "formula": { "type": "string", "minLength": 1, "maxLength": 140 },
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "label", "displayValue"],
            "properties": {
              "role": {
                "type": "string",
                "enum": ["numerator", "denominator", "population", "affected", "base", "derived"]
              },
              "label": { "type": "string", "minLength": 1, "maxLength": 80 },
              "value": { "type": "number" },
              "low": { "type": "number" },
              "high": { "type": "number" },
              "displayValue": { "type": "string", "minLength": 1, "maxLength": 60 },
              "unit": { "type": "string", "maxLength": 40 },
              "valueStatus": { "type": "string", "enum": ["reported", "derived", "bound", "approximate"] },
              "tone": {
                "type": "string",
                "enum": ["primary", "secondary", "warning", "critical", "neutral", "positive"]
              }
            }
          }
        }
      }
    },
    "emphasis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "label"],
      "properties": {
        "direction": { "type": "string", "enum": ["up", "down", "neutral"] },
        "value": { "type": "number" },
        "displayValue": { "type": "string", "maxLength": 40 },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "position": { "type": "string", "enum": ["between", "corner", "left"] }
      }
    },
    "primaryMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": { "type": "string", "minLength": 1, "maxLength": 40 },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "supportingFacts": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "label"],
        "properties": {
          "value": { "type": "string", "minLength": 1, "maxLength": 60 },
          "label": { "type": "string", "minLength": 1, "maxLength": 180 },
          "tone": {
            "type": "string",
            "enum": ["primary", "secondary", "warning", "critical", "neutral", "positive"]
          },
          "role": {
            "type": "string",
            "enum": ["comparison", "denominator", "mechanism", "consequence", "context"]
          }
        }
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["auto", "number", "progress", "pictogram"] },
        "icon": {
          "type": "string",
          "enum": ["dot", "person", "shield", "warehouse", "pause", "exit", "money", "ship", "fuel", "factory", "warning", "trend", "document"]
        },
        "total": { "type": "integer", "minimum": 2, "maximum": 100 },
        "filled": { "type": "integer", "minimum": 0, "maximum": 100 },
        "columns": { "type": "integer", "minimum": 2, "maximum": 20 }
      }
    },
    "note": { "type": "string", "maxLength": 240 },
    "narrative": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frame": {
          "type": "string",
          "enum": ["neutral", "warning", "surprise", "collapse", "recovery", "divergence", "comparison"]
        },
        "density": { "type": "string", "enum": ["minimal", "editorial", "detailed"] },
        "emphasis": {
          "type": "string",
          "enum": ["magnitude", "direction", "gap", "composition", "ranking", "range", "flow", "status", "geography", "risk", "duration", "benchmark-gap", "convergence"]
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "height": { "type": "string", "enum": ["short", "standard", "tall"] },
        "sort": { "type": "string", "enum": ["none", "ascending", "descending"] },
        "showLegend": { "type": "boolean" },
        "showLabels": { "type": "boolean" },
        "animate": { "type": "boolean" },
        "labelMode": {
          "type": "string",
          "enum": ["auto", "inside", "outside"],
          "description": "Column-label preference. auto is family-coherent: keep all labels outside when they fit, move the full bar family inside when endpoint headroom requires it and all bars can support inside labels, and mix placements only for a genuine physical-fit conflict."
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "topic": { "type": "string", "maxLength": 100 },
        "country": { "type": "string", "maxLength": 80 },
        "dataPeriod": { "type": "string", "maxLength": 80 },
        "keyFinding": { "type": "string", "maxLength": 240 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "not": {
          "properties": { "recipe": { "enum": ["map.regional", "trend.stacked"] } }
        }
      },
      "then": {
        "properties": {
          "data": {
            "maxItems": 12,
            "items": {
              "properties": {
                "callout": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "recipe": { "const": "flow.waterfall" } }
      },
      "then": {
        "properties": {
          "data": {
            "items": {
              "required": ["value", "role", "valueStatus", "period", "scope"],
              "properties": {
                "valueStatus": { "const": "reported" }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "recipe": { "const": "comparison.scenarios" } }
      },
      "then": {
        "properties": {
          "data": {
            "minItems": 3,
            "maxItems": 5
          }
        }
      }
    },
    {
      "if": {
        "properties": { "recipe": { "const": "timeline.duration" } }
      },
      "then": {
        "properties": {
          "data": {
            "minItems": 2,
            "maxItems": 8,
            "items": {
              "anyOf": [
                { "required": ["start", "end"] },
                { "required": ["duration", "durationUnit"] }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "recipe": { "const": "comparison.benchmark-gap" } }
      },
      "then": {
        "properties": {
          "data": {
            "minItems": 1,
            "maxItems": 6,
            "items": { "required": ["value", "benchmark", "quantity", "scope", "period"] }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "recipe": { "const": "relationship.converging-signals" } }
      },
      "then": {
        "required": ["relationship"],
        "properties": {
          "data": {
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "required": ["relationshipRole", "direction", "displayValue", "quantity", "scope", "period"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "recipe": { "const": "comparison.dumbbell" } }
      },
      "then": {
        "properties": {
          "data": {
            "minItems": 3,
            "maxItems": 10,
            "items": { "required": ["value", "benchmark", "quantity", "scope", "period"] }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "recipe": { "const": "trend.stacked" } }
      },
      "then": {
        "properties": {
          "data": {
            "minItems": 3,
            "maxItems": 24,
            "items": { "required": ["segments", "quantity", "scope", "period"] }
          }
        }
      }
    }
  ]
}
